{
	"name": "n8n-nodes-signatoro",
	"version": "0.1.0",
	"description": "Add the email signature saved on Signatoro - a person's, or an AI agent's with its AI disclosure line - to emails n8n workflows and AI agents send.",
	"license": "MIT",
	"homepage": "https://signatoro.com/docs/install-signature/agent/automations",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"email signature",
		"ai agent",
		"ai disclosure",
		"signatoro"
	],
	"author": {
		"name": "Signatoro",
		"email": "support@signatoro.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BlastraIO/n8n-nodes-signatoro.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SignatoroApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Signatoro/Signatoro.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.52.5",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
